{
  "name": "voxcue",
  "productName": "VoxCue",
  "version": "0.5.0",
  "private": true,
  "description": "VoxCue cross-platform desktop interview preparation assistant",
  "main": "dist-electron/shared/electron/main.js",
  "scripts": {
    "dev": "node scripts/launch.mjs --dev",
    "dev:web": "vite --config ../shared/vite.config.mjs --host 127.0.0.1",
    "build:shared": "tsc --noEmit && node ../shared/scripts/build-electron.mjs && vite build --config ../shared/vite.config.mjs",
    "start": "node scripts/launch.mjs",
    "test": "vitest run --config ../shared/vitest.config.mjs",
    "format": "node ../shared/scripts/format.mjs",
    "test:electron": "node ../shared/test/scripts/electron-smoke.mjs",
    "test:floating": "node ../shared/test/scripts/floating-smoke.mjs",
    "test:interview:screenshot": "node ../shared/test/scripts/interview-screenshot-smoke.mjs",
    "test:composer": "node ../shared/test/scripts/composer-smoke.mjs",
    "test:conversations": "node ../shared/test/scripts/conversations-smoke.mjs",
    "test:chat-response": "node ../shared/test/scripts/chat-response-smoke.mjs",
    "test:chat:progress": "node ../shared/test/scripts/chat-progress-smoke.mjs",
    "test:login": "node ../shared/test/scripts/login-smoke.mjs",
    "test:settings": "node ../shared/test/scripts/settings-smoke.mjs",
    "test:ui:alignment": "node ../shared/test/scripts/ui-alignment-smoke.mjs",
    "test:ui:ux": "node ../shared/test/scripts/ui-ux-smoke.mjs",
    "test:profile:ui": "node ../shared/test/scripts/profile-ui-smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.contracts.json",
    "check:architecture": "node ../shared/test/scripts/check-architecture.mjs",
    "download:speech": "node ../shared/scripts/download-speech-models.mjs",
    "download:rag": "node ../shared/scripts/download-rag-models.mjs",
    "test:speech:model": "node ../shared/test/scripts/run-electron-node.mjs ../shared/test/scripts/speech-model-check.mjs",
    "test:speech:soak": "node ../shared/test/scripts/run-electron-node.mjs ../shared/test/scripts/speech-soak.mjs --seconds=600",
    "test:conversations:status": "node ../shared/test/scripts/conversation-status-smoke.mjs",
    "test:login:entry": "node ../shared/test/scripts/login-entry-smoke.mjs",
    "test:history": "node ../shared/test/scripts/history-branding-smoke.mjs",
    "test:updates": "node ../shared/test/scripts/updates-smoke.mjs",
    "test:knowledge": "node ../shared/test/scripts/knowledge-smoke.mjs",
    "test:rag:core": "node ../shared/test/scripts/rag-core-smoke.mjs",
    "test:rag:ui": "node ../shared/test/scripts/rag-ui-smoke.mjs",
    "test:ui:typography": "node ../shared/test/scripts/typography-smoke.mjs",
    "test:delete:ui": "node ../shared/test/scripts/delete-controls-smoke.mjs",
    "test:provider:ui": "node ../shared/test/scripts/provider-ui-smoke.mjs",
    "test:chat:lifecycle": "node ../shared/test/scripts/chat-lifecycle-smoke.mjs",
    "test:adversarial": "node ../shared/test/scripts/adversarial-smoke.mjs",
    "check:workspace": "node ../shared/scripts/sync-platform-manifests.mjs --check && node ../shared/scripts/check-platform-layout.mjs",
    "build": "pnpm build:audio && pnpm build:permissions && pnpm build:symbols && pnpm build:shared && pnpm build:launcher",
    "build:audio": "node scripts/build-audio.mjs",
    "test:audio:native": "node test/scripts/audio-native-smoke.mjs",
    "test:window:native": "node test/scripts/window-native-smoke.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "test:launcher": "node test/scripts/launcher-smoke.mjs",
    "test:icons": "node test/scripts/icons-smoke.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:symbols": "node scripts/build-symbols.mjs",
    "build:permissions": "node scripts/build-permissions.mjs",
    "test:screen-permission": "node test/scripts/screen-permission-smoke.mjs",
    "build:updater": "node scripts/build-updater.mjs",
    "package:installer": "pnpm build && pnpm build:updater && node scripts/package-installer.mjs",
    "test:updates:native": "node test/scripts/updates-native-smoke.mjs",
    "test:package": "node test/scripts/package-smoke.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "@fluentui/react-icons": "^2.0.0",
    "@huggingface/transformers": "4.3.1",
    "@lancedb/lancedb": "0.40.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "jose": "^5.10.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "1.13.8",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0",
    "@ennuicastr/webrtcaec3.js": "0.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "@electron/packager": "19.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.8"
  }
}
