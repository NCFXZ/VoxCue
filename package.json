{
  "name": "voxcue",
  "productName": "VoxCue",
  "version": "0.1.0",
  "private": true,
  "description": "VoxCue Windows desktop interview preparation assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-audio.mjs && tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "vitest run",
    "format": "prettier --write src electron scripts *.json *.ts *.md *.yaml",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:floating": "node scripts/floating-smoke.mjs",
    "test:interview:effort": "node scripts/interview-effort-smoke.mjs",
    "test:composer": "node scripts/composer-smoke.mjs",
    "test:conversations": "node scripts/conversations-smoke.mjs",
    "test:chat-response": "node scripts/chat-response-smoke.mjs",
    "test:login": "node scripts/login-smoke.mjs",
    "test:settings": "node scripts/settings-smoke.mjs",
    "test:ui:alignment": "node scripts/ui-alignment-smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.contracts.json",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:audio": "node scripts/build-audio.mjs",
    "download:speech": "node scripts/download-speech-models.mjs",
    "test:speech:model": "node scripts/run-electron-node.mjs scripts/speech-model-check.mjs",
    "test:speech:devices": "node scripts/run-electron-node.mjs scripts/speech-device-check.mjs",
    "test:speech:soak": "node scripts/run-electron-node.mjs scripts/speech-soak.mjs --seconds=600",
    "test:speech:desktop": "node scripts/speech-desktop-smoke.mjs",
    "test:speech:package": "node scripts/speech-desktop-smoke.mjs --packaged",
    "test:speech:reliability": "node scripts/run-electron-node.mjs scripts/speech-reliability.mjs",
    "test:interview:workflow": "node scripts/interview-workflow-smoke.mjs",
    "test:conversations:status": "node scripts/conversation-status-smoke.mjs",
    "test:interview:access": "node scripts/interview-access-smoke.mjs",
    "test:login:entry": "node scripts/login-entry-smoke.mjs",
    "test:interview:access:native": "node scripts/interview-access-native.mjs",
    "test:history": "node scripts/history-branding-smoke.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "test:knowledge": "node scripts/knowledge-smoke.mjs",
    "test:package": "node scripts/packaged-smoke.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
