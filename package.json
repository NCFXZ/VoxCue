{
  "name": "ai-interview-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI Interview Copilot Windows desktop frontend",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "vitest run",
    "format": "prettier --write src electron scripts *.json *.ts *.md *.yaml",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:floating": "node scripts/floating-smoke.mjs",
    "test:composer": "node scripts/composer-smoke.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
