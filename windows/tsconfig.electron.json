{
  "extends": "../shared/tsconfig.electron.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/@types/*",
        "node_modules/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "rootDir": "..",
    "outDir": "dist-electron"
  },
  "include": [
    "../shared/electron",
    "../windows/electron",
    "../macos/electron"
  ]
}
